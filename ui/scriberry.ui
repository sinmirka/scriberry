   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #121018;
    color: #f1eef6;
}
QWidget {
    color: #f1eef6;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
}
QLabel { background: transparent; border: none; }
QLabel#brandMark {
    background: transparent;
}
QLabel#titleLabel { font-size: 27px; font-weight: 700; }
QLabel#subtitleLabel, QLabel#formatsLabel, QLabel#modelHintLabel,
QLabel#deviceHintLabel, QLabel#outputHintLabel, QLabel#progressDetailLabel {
    color: #a7a0b5;
    font-size: 12px;
}
QLabel#badgeLabel, QLabel#fileCountLabel {
    background: #282031;
    color: #c9afea;
    border-radius: 10px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#filesTitleLabel, QLabel#settingsTitleLabel,
QLabel#outputTitleLabel, QLabel#logsTitleLabel {
    font-size: 14px;
    font-weight: 600;
}
QLabel#stateLabel { color: #c3addf; font-weight: 600; }
QLabel#percentLabel { color: #cbb3fa; font-weight: 600; }
QFrame#filesCard, QFrame#settingsCard, QFrame#outputCard, QFrame#logsCard {
    background: #1b1723;
    border: 1px solid #302938;
    border-radius: 14px;
}
QPushButton {
    background: #2b2435;
    border: 1px solid #45384f;
    border-radius: 8px;
    padding: 9px 16px;
    font-weight: 600;
}
QPushButton:hover { background: #392e45; border-color: #8e6fb1; }
QPushButton:pressed { background: #463652; }
QPushButton:focus { border: 1px solid #c6a2f3; }
QPushButton:disabled { color: #756d82; background: #211c29; border-color: #332b3e; }
QPushButton#startButton {
    background: #bca1f7;
    color: #251636;
    border: 1px solid #bca1f7;
}
QPushButton#startButton:hover { background: #cfb6ff; border-color: #cfb6ff; }
QPushButton#startButton:pressed { background: #a889e0; }
QPushButton#startButton:disabled { background: #44364f; color: #9c8aaa; border-color: #44364f; }
QLineEdit, QComboBox {
    background: #14111b;
    border: 1px solid #3a3046;
    border-radius: 8px;
    padding: 9px 11px;
    selection-background-color: #60447d;
    selection-color: #ffffff;
}
QLineEdit:focus, QComboBox:focus { border-color: #bca1f7; }
QComboBox:hover { border-color: #87669f; }
QComboBox::drop-down { width: 28px; border: none; }
QComboBox QAbstractItemView {
    background: #241d2d;
    border: 1px solid #554164;
    padding: 5px;
    selection-background-color: #60447d;
    selection-color: #ffffff;
    outline: 0;
}
QTreeWidget {
    background: #14111b;
    alternate-background-color: #1a1522;
    border: 1px solid #302938;
    border-radius: 8px;
    selection-background-color: #483254;
    selection-color: #f8f2ff;
    outline: 0;
}
QTreeWidget::item { padding: 8px 5px; border: none; }
QTreeWidget::item:hover { background: #2a2134; }
QTreeWidget::item:selected { background: #483254; }
QHeaderView::section {
    background: #241d2d;
    color: #b8aec7;
    border: none;
    border-bottom: 1px solid #382d43;
    padding: 9px 8px;
    font-size: 12px;
}
QPlainTextEdit {
    background: #14111b;
    color: #b9b0c7;
    border: 1px solid #302938;
    border-radius: 8px;
    padding: 10px;
    font-family: &quot;Cascadia Code&quot;, &quot;Consolas&quot;, monospace;
    font-size: 12px;
    selection-background-color: #60447d;
}
QProgressBar {
    background: #302637;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    max-height: 10px;
}
QProgressBar::chunk { background: #bca1f7; border-radius: 5px; }
QScrollBar:vertical { background: #1b1723; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #51405f; min-height: 24px; border-radius: 5px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QToolTip { background: #30243b; color: #f1eef6; border: 1px solid #6f5089; padding: 5px; }
